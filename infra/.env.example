# infra/.env.example — infra/.env 로 복사해 채운다. (.env 는 리포 루트 .gitignore 로 제외됨)
#
# ⚠️ 실제 토큰·자격을 이 파일(.env.example)에 적어 커밋하지 않는다. 여기엔 자리표시자만.
#   cp .env.example .env  &&  ${EDITOR:-vi} .env

# ── 필수 ─────────────────────────────────────────────────────────────────────
# /internal/** 게이트 토큰. java(HMB_SERVANT_INTERNALTOKEN)와 executor(SERVANT_TOKEN)가
# 같은 값이어야 한다. 기본값 change-me 는 **로컬 전용** — 외부 노출(Tunnel) 전 반드시 교체.
#   생성: openssl rand -hex 32
SERVANT_TOKEN=change-me

# ── 호스트 포트 (데모 8080/8790 무접촉 → 대체 포트) ──────────────────────────
JAVA_HOST_PORT=18080
RUNNER_HOST_PORT=18790

# ── CORS (#128) — web 오리진 허용 목록 (콤마 구분) ────────────────────────────
# web 은 CF Pages(별도 오리진) → 여기에 Pages URL 을 넣어야 브라우저가 API 를 부를 수 있다.
# 예: https://hmb.pages.dev,https://api-preview.pages.dev
# quick tunnel/preview URL 이 바뀌면 이 값만 바꾸고 java 재시작(재빌드 불필요).
WEB_ORIGINS=http://localhost:5173

# ── Cloudflare Pages 배포 (로그인 대신 API 토큰) ──────────────────────────────
# ⚠️ 실제 토큰/계정ID 는 infra/.env(gitignore)에만. 절대 커밋 금지 — 여긴 자리표시자만.
# 토큰 생성: dash.cloudflare.com → My Profile → API Tokens → "Edit Cloudflare Workers"
#   또는 커스텀(권한 Account : Cloudflare Pages : Edit). 계정ID = 대시보드 우측/URL 의 account id.
# 채워지면 `bash infra/deploy-pages.sh` 로 로그인 없이 Pages 배포.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── AI 실행기 ────────────────────────────────────────────────────────────────
# stub       = claude CLI 불필요, 대기 0초. 오프라인 E2E·AC-G1 검증 기본값.
# claude-code= 라이브. 모드 A(호스트 실행) 또는 모드 B(ai-live override) 에서만.
AI_EXECUTOR=stub
AI_CONCURRENCY=2
AI_MODEL=sonnet

# 모드 B 전용 — 호스트 구독 세션 디렉토리. 기본 ~/.claude.
# CLAUDE_HOME=/Users/you/.claude

# ⚠️ ANTHROPIC_API_KEY 를 여기에 넣지 말 것.
#    설정되면 구독이 아닌 **종량 과금**으로 청구된다. executor 가 기동 시 강제 삭제하지만
#    (packages/server/src/executor/executor-main.ts prepareExecutorEnv) 주입 자체를 하지 않는다.

# ── admin (PRD-v4 §C / P3-D4) ────────────────────────────────────────────────
# ⚠️ 변수명은 application.yml:112-113 이 권위다 — **NICKNAME** 이지 USERNAME 이 아니다.
#    (2026-08-07 까지 이 파일은 HMB_ADMIN_USERNAME 을 문서화하고 있었다. 그대로 .env 를 만들면
#     password 만 채워지고, application.yml:110 "하나만 채우면 부팅 실패" 에 걸려 java 가 안 뜬다.)
# 둘 다 비면 admin 0명(안전 기본) + 부팅 시 잔존 is_admin 회수. 반드시 **짝으로** 채운다.
# 목업 수준(평문)이며 실서비스 전 교체 대상임을 open-checklist.md 보안 항목에 박제.
# HMB_ADMIN_NICKNAME=
# HMB_ADMIN_PASSWORD=

# ── 매치 잡 타임아웃 (Spring relaxed binding → hmb.match.*) ───────────────────
# ⚠️ 이 두 키는 application.yml 에 `${HMB_...}` 로 안 나온다(relaxed binding) — grep 으로 찾지
#    못하므로 여기에 적어 두지 않으면 이사 때 **조용히 사라진다**. 상세 = infra/env-contract.txt.
# ai-job-timeout-sec: 코드 기본 240. 라이브는 600 으로 운영 중(#166 — sonnet 전술생성 90~180s.
#   짧으면 리스 만료→재시도→매치 FAILED). 이사 시 **값까지 옮겨야 한다**.
# HMB_MATCH_AIJOBTIMEOUTSEC=600
# lease-sec: 코드 기본이 이미 300 이라 지금은 지정할 필요 없다(라이브 잔존값 = 무해).
# HMB_MATCH_LEASESEC=300

# ── 이사·재구축 시 ────────────────────────────────────────────────────────────
# 이 파일이 아니라 infra/env-contract.txt 가 **권위 키셋**이다(등급 req/carry/opt 포함).
# 대조:  bash infra/check-env-contract.sh      # 값은 출력하지 않는다. 키 이름만.
