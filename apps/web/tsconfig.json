{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    // 스태틱 모드(#444)가 `data/**` 발행물(선수·봇·경제 시드)을 그대로 번들한다.
    "resolveJsonModule": true,
    "paths": {
      // 관전 렌더/투영 코어(#169 P4-D3). vite.config.ts 의 alias 와 짝 — 둘 다 있어야
      // 타입체크와 번들이 같은 파일을 본다.
      "@hmb/viewer-core": ["../../packages/viewer-core/src/index.ts"],
      "@hmb/shared": ["../../packages/shared/src/index.ts"]
      // ⚠️ `@hmb/engine-runtime`·`@hmb/server-stub`(#444)은 여기 **넣지 않는다** — 넣으면 남의
      // 패키지 소스가 web 의 린트 설정(noUnusedLocals)으로 심판된다. 타입은 앰비언트 선언
      // (`src/static/externals.d.ts`)이, 번들은 vite alias 가 맡는다.
    }
  },
  "include": ["src", "vite.config.ts"]
}
