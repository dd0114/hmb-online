{
  "name": "@hmb/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-viewer.mjs && node scripts/ensure-chars.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-viewer.mjs && node scripts/ensure-chars.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "e2e": "playwright test",
    "build:viewer": "node scripts/build-viewer.mjs",
    "build:chars": "node scripts/build-chars.mjs",
    "gen:types": "npm run gen:types:v1 && npm run gen:types:v2",
    "gen:types:v1": "openapi-typescript ../../docs/plan-v2/api/openapi.yaml -o src/api/schema.d.ts",
    "gen:types:v2": "openapi-typescript ../../docs/plan-v3/api/openapi-v2.yaml -o src/api/schema-v2.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@dnd-kit/core": "^6.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "vite": "^5.4.11"
  }
}
