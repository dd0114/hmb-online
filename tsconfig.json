{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@hmb/shared": ["./packages/shared/src/index.ts"],
      "@hmb/engine": ["./packages/engine/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"],
  // ⚠️ `apps/web` · `packages/server` 는 자기 컴파일러 옵션(jsx·DOM·Bundler resolution·noUnusedLocals 등)이
  // 필요해서 여기서 제외하고 **각자 tsconfig 로 따로** 체크한다. 제외 = 안 봐도 된다는 뜻이 아니다 —
  // 루트 `npm run typecheck` 가 `apps/web/tsconfig.json` 을 두 번째 프로젝트로 이어서 돌린다(#226).
  // 그 배선이 없던 동안 web 을 타입체크하는 게이트가 web 빌드뿐이어서, 테스트 파일의 미사용 import
  // 하나(TS6133)가 게이트를 통과해 v8.01 배포를 멈췄다(#216 → 핫픽스 bd00b07).
  // `packages/server` 는 아직 그 배선 밖이다 — 같은 구멍이 남아 있다.
  "exclude": ["**/node_modules", "**/dist", "packages/engine/dev-viewer/e2e", "packages/server", "apps/web"]
}
